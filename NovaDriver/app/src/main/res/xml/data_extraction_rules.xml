<?xml version="1.0" encoding="utf-8"?>
<!-- Session tokens are bound to this device's Keystore key: never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nova_driver_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nova_driver_auth.xml" />
    </device-transfer>
</data-extraction-rules>
