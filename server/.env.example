DATABASE_URL=postgres://localhost/nova_dev
BIND_ADDR=0.0.0.0:3000

# Twilio Verify Service
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...

# Resend Email Service
RESEND_API_KEY=re_...
RESEND_FROM="Nova <auth@novataxis.co.nz>"

# Security Secrets
JWT_SECRET=replace_with_at_least_32_bytes_random_secret
OTP_HMAC_SECRET=replace_with_at_least_32_bytes_random_secret

OTP_DEV_LOG=false

# AWS S3 (Signed URLs for Nova Rider, Driver & Admin)
AWS_S3_BUCKET=nova-taxi-media-670604917402
AWS_REGION=ap-southeast-6
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Development only: approve driver applications instantly instead of waiting for an admin
# (PATCH /v1/admin/drivers/{id}). Never set this in production.
# DRIVER_AUTO_APPROVE=true
